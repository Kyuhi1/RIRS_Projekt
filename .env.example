# Kopiraj v .env (cp .env.example .env) in nastavi svoje vrednosti.
# Datoteka .env je v .gitignore in se ne sme commitati.

POSTGRES_USER=backtester
# Geslo brez posebnih znakov (@ / : #), ker je del DATABASE_URL.
POSTGRES_PASSWORD=spremeni-me
POSTGRES_DB=backtester

# Skrivnost za podpis JWT (najmanj 32 znakov). Ustvari jo npr. z: openssl rand -hex 32
JWT_SECRET=zamenjaj-me-z-dolgim-nakljucnim-nizom-32+

# Administratorski račun, ustvarjen ob zagonu backenda (geslo najmanj 8 znakov).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=spremeni-me-admin
